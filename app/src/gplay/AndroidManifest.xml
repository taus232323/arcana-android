<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Google Play restricts REQUEST_INSTALL_PACKAGES to apps whose core purpose is installing packages.
      Arcana is a messenger, so strip this permission from Play builds. F-Droid keeps it from main.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- Calls use a visible activity / PiP, not a background microphone service.
         Strip this so Play review does not require a FOREGROUND_SERVICE_MICROPHONE declaration. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
</manifest>
